{
  "name": "@euphoria/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @euphoria/engine build && tsc --noEmit -p tsconfig.json && storybook build",
    "dev": "pnpm --filter @euphoria/engine build && storybook dev -p 6006",
    "start": "pnpm dev",
    "typecheck": "pnpm --filter @euphoria/engine build && tsc --noEmit -p tsconfig.json",
    "bench": "node scripts/bench-balls.mjs",
    "storybook": "storybook dev -p 6006"
  },
  "dependencies": {
    "@euphoria/engine": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@storybook/html-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "storybook": "^10.6.7",
    "vite": "^8.3.6"
  }
}
